<!DOCTYPE html>
<html>
  <head>
    <meta http-equiv="content-type" content="text/html; charset=UTF-8">
    <title>Trivariate normal distribution</title>
    <script src="https://cdn.jsdelivr.net/npm/jstat@latest/dist/jstat.min.js" type="text/javascript"></script>
    <script type="text/javascript" src="https://cdn.plot.ly/plotly-3.5.1.min.js"></script>
    <link href="https://wkristan.github.io/style.css" rel="stylesheet" type="text/css">
    <script type="text/javascript" src="https://wkristan.github.io/main.js"></script>
    <script type="text/javascript" src="multivariate-normal.min.js"></script>
    <style>
      td {
      	width: 50px;
      }
       .container { 
	      display: grid;
         width: 1200px;
         height: 800px;
	  	}
      .graph {
        width: 850px;
        grid-column:1;
      }
      .cormat {
        width:350px;
        grid-column:2;
        padding: 20px;
      }
    </style>
  </head>
  <body onload="drawGraph()">
    <div class="container">
      <div id="3d_graph_div" class="graph"> </div>
      <div id="controls_div" class="cormat">
        <h3>
          Multivariate normal distribution with 3 variables
        </h3>
        <p>Correlation matrix:</p>
        <table class="tableLarge">
          <tbody>
            <tr>
              <th><br>
              </th>
              <th>x</th>
              <th>y</th>
              <th>z</th>
            </tr>
            <tr>
              <td>x</td>
              <td>1</td>
              <td><span id="r_xy" class="xy">0</span></td>
              <td><span id="r_xz" class="xz">0<br>
                </span></td>
            </tr>
            <tr>
              <td>y</td>
              <td> <input id="r_yx" class="xy" style="text-align: center; width:50px" value="0" min="-0.99" max="0.99" step="0.01" type="number"> </td>
              <td>1</td>
              <td><span id="r_yz" class="yz">0</span></td>
            </tr>
            <tr>
              <td>z</td>
              <td> <input id="r_zx" class="xz" style="text-align: center; width:50px" value="0" min="-0.99" max="0.99" step="0.01" type="number"> </td>
              <td> <input id="r_zy" class="yz" style="text-align: center; width:50px" value="0" min="-0.99" max="0.99" step="0.01" type="number"> </td>
              <td>1</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
    <script type="text/javascript" src="trivar_normal.js"></script>
  </body>
</html>
