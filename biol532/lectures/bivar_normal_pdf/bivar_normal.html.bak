<!DOCTYPE html>
<html>
  <head>
    <meta http-equiv="content-type" content="text/html; charset=UTF-8">
    <title>Bivariate normal distribution</title>
    <script type="text/javascript" src="https://cdn.plot.ly/plotly-3.5.1.min.js"></script>
    <link href="https://wkristan.github.io/style.css" rel="stylesheet" type="text/css">
    <script type="text/javascript" src="https://wkristan.github.io/main.js"></script>
    <style>
       .container { 
      display: grid;
      width: 1200px;
      height: 825px;
      grid-template-columns: 1fr;
      grid-template-rows: auto 675px auto;
		}
      .surface_div {
        grid-column:1;
        grid-row:2;
      }
      .cor_div {
        grid-column:1;
        grid-row:1;
        justify-self: center;
      }
      .settings_div {
        grid-column:1;
        grid-row:3;
        justify-self: center;
      }
     
  
  </style>
  </head>
  <body onload="drawSurface(0)">
    <div class="container">
      <div class="surface_div" id="surface_div"> </div>
			<div class="cor_div">
	      <p>Bivariate normal distribution with correlation between x and y of <input id="corr" min="-0.99" max="0.99" value="0" step="0.01" type="number" style="width:30px"></p>
      </div>
      <div class="settings_div" id="controls_div">
        <div style="display:grid; width:900px; height:80px; grid-template-columns:1fr 1fr">
        <p>Popup x,y,z values: <input id="showtips" type="checkbox"></p>
        <p>Show curve along x: <input id="show_xcurve" type="checkbox"></p>
        <p>Show curve along y: <input id="show_ycurve" type="checkbox"></p>
        <p>Show surface contour (z): <input id="show_contour" type="checkbox"></p>
        </div>
        
      </div>
    </div>
    <script type="text/javascript" src="bivar_normal.js"></script>
  </body>
</html>
