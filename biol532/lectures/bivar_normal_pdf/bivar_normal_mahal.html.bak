<!DOCTYPE html>
<html>
  <head>
    <meta http-equiv="content-type" content="text/html; charset=UTF-8">
    <title>Bivariate normal distribution with Mahalanobis distances</title>
    <script src="https://cdn.jsdelivr.net/npm/jstat@latest/dist/jstat.min.js" type="text/javascript"></script>
    <script type="text/javascript" src="https://cdn.plot.ly/plotly-3.5.1.min.js"></script>
    <link href="https://wkristan.github.io/style.css" rel="stylesheet" type="text/css">
    <script type="text/javascript" src="https://wkristan.github.io/main.js"></script>
    <script type="text/javascript" src="multivariate-normal.min.js"></script>
    <style>
    .container { 
      display: grid;
      width: 1200px;
      height: 650px;
      grid-template-columns: 600px auto;
      grid-template-rows: auto 500px auto;
      border: 1px solid black;
		}
      .mahal_graph_div {
        grid-column:1;
        grid-row:2;
        border: 1px solid blue;
      }
      .mahal_histo_div {
      	grid-column: 2;
        grid-row: 2;
        border: 1px solid yellow;
      }
      .cor_div {
        grid-column-start:0;
				grid-column-end:2;  
        grid-row:1;
        justify-self: center;
        border: 1px solid green;
      }
      .settings_div {
        grid-column-start:0;
				grid-column-end:2;        
        grid-row:3;
        justify-self: center;
        border: 1px solid orange;
      }
     
  
  </style>
  </head>
  <body onload="drawGraph()">
    <div class="container">
      <div class="mahal_graph_div" id="mahal_graph_div"> </div>
      <div class="mahal_histo_div" id="mahal_histo_div"></div>
      <div class="cor_div">
        <p>Bivariate normal data with correlation of <input id="corr" min="-0.99" max="0.99" value="0" step="0.01" style="width:50px" type="number"></p>
      </div>
      <div class="settings_div" id="controls_div">
          <p><span>Popup x,y,z values: <input id="showtips" type="checkbox"></span>
            <span>Show curve along x: <input id="show_xcurve" type="checkbox"></span></p>
          <p><span>Show curve along y: <input id="show_ycurve" type="checkbox"></span>
        <span>Show surface contour (z): <input id="show_contour" type="checkbox"></span></p>
      </div>
    </div>
    <script type="text/javascript" src="bivar_mahalanobis.js"></script>
  </body>
</html>
