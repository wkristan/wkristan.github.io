     </mrow>
    </mrow>
    <mo fence="true" form="postfix" stretchy="false">)</mo>
   </mrow>
  </mrow>
  <annotation encoding="StarMath 5.0">D^2 = ( bold v - bold %mu)&apos;{bold S}^{-1}(bold v - bold %mu )</annotation>
 </semantics>
